[
  {"id":"e01","ruleId":"rule1","textAr":"قَرَّرَتْ مَرْيَمُ أَنْ تَتَعَلَّمَ مَهَارَةً جَدِيدَةً.","translationEn":"Maryam decided to learn a new skill.","focus":"أَنْ تَتَعَلَّمَ","audio":"audio/example-e01.mp3"},
  {"id":"e02","ruleId":"rule1","textAr":"نُرِيدُ أَنْ نُشَارِكَ فِي المَشْرُوعِ.","translationEn":"We want to participate in the project.","focus":"أَنْ نُشَارِكَ","audio":"audio/example-e02.mp3"},
  {"id":"e03","ruleId":"rule1","textAr":"يُحَاوِلُ الفَرِيقُ أَنْ يَنْجَحَ فِي المُهِمَّةِ.","translationEn":"The team is trying to succeed in the task.","focus":"أَنْ يَنْجَحَ","audio":"audio/example-e03.mp3"},
  {"id":"e04","ruleId":"rule1","textAr":"قَرَّرَ الطُّلَّابُ أَنْ يَعْمَلُوا مَعًا.","translationEn":"The students decided to work together.","focus":"أَنْ يَعْمَلُوا","audio":"audio/example-e04.mp3"},
  {"id":"e05","ruleId":"rule1","textAr":"تُرِيدِينَ أَنْ تَخْتَارِي مَوْضُوعًا مُنَاسِبًا.","translationEn":"You want to choose a suitable topic.","focus":"أَنْ تَخْتَارِي","audio":"audio/example-e05.mp3"},
  {"id":"e06","ruleId":"rule1","textAr":"نَسْتَطِيعُ أَنْ نَسْتَعْمِلَ التَّطْبِيقَ.","translationEn":"We can use the application.","focus":"أَنْ نَسْتَعْمِلَ","audio":"audio/example-e06.mp3"},
  {"id":"e07","ruleId":"rule1","textAr":"يُفَضِّلُ خَالِدٌ أَنْ يَتَوَاصَلَ مَعَ المُعَلِّمِ بِالبَرِيدِ.","translationEn":"Khalid prefers to contact the teacher by email.","focus":"أَنْ يَتَوَاصَلَ","audio":"audio/example-e07.mp3"},
  {"id":"e08","ruleId":"rule2","textAr":"يَحْتَاجُ المَشْرُوعُ إِلَى تَخْطِيطٍ جَيِّدٍ.","translationEn":"The project needs good planning.","focus":"إِلَى تَخْطِيطٍ","audio":"audio/example-e08.mp3"},
  {"id":"e09","ruleId":"rule2","textAr":"شَارَكْنَا فِي تَنْظِيمِ وَرْشَةٍ ثَقَافِيَّةٍ.","translationEn":"We participated in organizing a cultural workshop.","focus":"فِي تَنْظِيمِ","audio":"audio/example-e09.mp3"},
  {"id":"e10","ruleId":"rule2","textAr":"نَجَحَ الفَرِيقُ فِي تَنْفِيذِ الخُطَّةِ.","translationEn":"The team succeeded in carrying out the plan.","focus":"فِي تَنْفِيذِ","audio":"audio/example-e10.mp3"},
  {"id":"e11","ruleId":"rule2","textAr":"أَهْتَمُّ بِتَطْوِيرِ لُغَتِي العَرَبِيَّةِ.","translationEn":"I am interested in developing my Arabic.","focus":"بِتَطْوِيرِ","audio":"audio/example-e11.mp3"},
  {"id":"e12","ruleId":"rule2","textAr":"سَاعَدَنِي زَمِيلِي عَلَى فَهْمِ التَّمْرِينِ.","translationEn":"My colleague helped me understand the exercise.","focus":"عَلَى فَهْمِ","audio":"audio/example-e12.mp3"},
  {"id":"e13","ruleId":"rule2","textAr":"تَوَاصَلْتُ مَعَ المُعَلِّمِ بَعْدَ الدَّرْسِ.","translationEn":"I contacted the teacher after the lesson.","focus":"مَعَ المُعَلِّمِ","audio":"audio/example-e13.mp3"},
